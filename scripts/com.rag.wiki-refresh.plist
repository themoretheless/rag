<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent for scripts/wiki-refresh.sh.

  Install:
    cp scripts/com.rag.wiki-refresh.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.rag.wiki-refresh.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.rag.wiki-refresh.plist

  RunAtLoad is false on purpose: the agent must not fire while the rag-mcp
  gateway is still starting. The script is a no-op when the gateway is down,
  but a first run at login would only ever log a FATAL line.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rag.wiki-refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/themoretheless/Documents/Sources/rag/scripts/wiki-refresh.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/themoretheless/Documents/Sources/rag</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>RAG_MCP_URL</key>
    <string>http://127.0.0.1:7432/mcp</string>
    <key>RAG_CRON_WING</key>
    <string>rag</string>
  </dict>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardErrorPath</key>
  <string>/Users/themoretheless/Documents/Sources/rag/.rag/wiki-refresh.err</string>
</dict>
</plist>
